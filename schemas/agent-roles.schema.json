{
  "_attribution": "llm-orchestrator · created by Bogdan-Gabriel Torcescu · https://www.linkedin.com/in/bogdantorcescu/ · keep this credit when copying or deriving",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tbogdan/llm-orchestrator/main/schemas/agent-roles.schema.json",
  "title": "Agent role roster and permission profiles",
  "type": "object",
  "required": [
    "version",
    "permission_profiles",
    "roles"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "permission_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "required_access",
          "rules"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "required_access": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "capabilities",
          "skills",
          "mcps",
          "best_for",
          "charter",
          "permission_profile",
          "default_tier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mcps": {
            "type": "array",
            "description": "Real MCP server ids only (an id or alias of an installable MCP in registries/preferred-tools.json). A capability whose implementation the project binds goes in tool_capabilities instead.",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "tool_capabilities": {
            "type": "array",
            "description": "Capability classes the role needs whose concrete tool the project binds (a database client, a provider API). Rendered as capabilities, never as a server name to search for.",
            "items": {
              "type": "object",
              "required": [
                "capability",
                "label"
              ],
              "properties": {
                "capability": {
                  "type": "string",
                  "pattern": "^[a-z][a-z_]*\\.[a-z][a-z_.]*$",
                  "description": "Capability id, as used in registries/preferred-tools.json and registries/task-mappings.json."
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\r\\n`]+$",
                  "description": "Plain-language name of the capability class, e.g. 'database client'."
                }
              },
              "additionalProperties": false
            }
          },
          "best_for": {
            "type": "string"
          },
          "charter": {
            "type": "object",
            "description": "Role-specific operating charter rendered into the body of each native agent file by adapters/agents.mjs. Every string is one line of plain prose.",
            "required": [
              "mission",
              "principles",
              "done_when",
              "never",
              "handoff"
            ],
            "properties": {
              "mission": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$",
                "description": "One-sentence identity, in second person."
              },
              "principles": {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\r\\n]+$"
                },
                "description": "Concrete operating rules specific to this role."
              },
              "done_when": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\r\\n]+$"
                },
                "description": "Observable exit criteria."
              },
              "never": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\r\\n]+$"
                },
                "description": "Role-specific prohibitions."
              },
              "handoff": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\r\\n]+$",
                "description": "What the role returns to its parent."
              }
            },
            "additionalProperties": false
          },
          "permission_profile": {
            "type": "string"
          },
          "default_tier": {
            "type": "string",
            "pattern": "^[WSXF] T[0-5](-T[0-5])?$",
            "description": "Tier and thinking level pair resolved by registries/routing-matrix.json."
          },
          "review_floor": {
            "type": "string",
            "pattern": "^[WSXF] T[0-5](-T[0-5])?$",
            "description": "Minimum review pair for this role domain, where policies/routing.md states one."
          }
        },
        "additionalProperties": false
      }
    },
    "role_aliases": {
      "type": "object",
      "description": "Generic function words used in workflow role tables, each resolving to one or more concrete role ids.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "roles",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
